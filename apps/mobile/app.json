{
  "expo": {
    "name": "Fresher Hub",
    "slug": "fresher-hub",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fresher-hub",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
        "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1A2B4A",
        "foregroundImage": "./assets/images/icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.adoumouangnamouemmanuel.fresherhub",
      "googleServicesFile": "./google-services.json",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDcHy0fIE9Xd08VCOHYHOPabk-4zPvKYww"
        }
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1A2B4A",
          "dark": {
            "backgroundColor": "#1A2B4A"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-asset",
      [
        "@rnmapbox/maps",
        {
          "RNMapboxMapsImpl": "mapbox"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6c767db8-01f9-41bc-8952-44fa6a48fac5"
      }
    }
  }
}
