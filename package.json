{
  "name": "fresher-hub",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "check": "turbo run check",
    "db:generate": "npm run generate -w @fresher-hub/db",
    "db:migrate": "npm run migrate -w @fresher-hub/db",
    "db:seed": "npm run seed -w @fresher-hub/db",
    "db:import-admissions": "npm run import:admissions -w @fresher-hub/db"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "turbo": "^2.0.6",
    "typescript": "^7.0.2"
  }
}
